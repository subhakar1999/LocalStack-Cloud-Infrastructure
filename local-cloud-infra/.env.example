# LocalStack Environment Configuration
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LocalStack Gateway & Ports
LOCALSTACK_HOST=localhost
GATEWAY_PORT=4566
EXTERNAL_SERVICE_PORTS=4510-4559

# Enabled LocalStack Services (Community Edition)
SERVICES=s3,dynamodb,sqs,sns,lambda,iam

# LocalStack Configuration
DEBUG=0
DOCKER_HOST=unix:///var/run/docker.sock

# Host directory for persistent state data
DATA_DIR=./.localstack
